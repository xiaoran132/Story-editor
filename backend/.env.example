DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=story_editor
JWT_SECRET=change-me-in-production
# 用户敏感数据（自带 LLM key）的加密密钥，与 JWT_SECRET 分开；生产务必改成随机长串
ENCRYPTION_KEY=change-me-encryption-key
SERVER_PORT=:8080
AGENT_URL=http://localhost:8001
# 图片上传：落盘根目录（相对路径以 backend/ 为基准）与单张上限（MB）
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
