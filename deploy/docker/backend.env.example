# 复制为 backend.env（compose env_file 注入）。纯 KEY=value。
# host 网络下容器用 127.0.0.1 直连宿主 PG 与 Agent。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=你的密码
DB_NAME=story_editor
JWT_SECRET=换成随机长串
# 用户敏感数据（自带 LLM key）加密密钥，与 JWT_SECRET 分开，换成随机长串
ENCRYPTION_KEY=换成随机长串
AGENT_URL=http://127.0.0.1:8001
SERVER_PORT=127.0.0.1:8080
# 图片上传落盘目录。必须是 compose 里挂了持久卷的路径，否则容器重建即丢图。
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=5
