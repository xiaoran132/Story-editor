# AI 服务监听地址
AI_HOST=0.0.0.0
AI_PORT=8001

# 这里没有 LLM 凭据，也不需要配。
# agent 不持有任何 key/端点/模型名——全部由 Go 后端按环节解析后随每个请求下发
# （玩家自带连接，或平台额度）。曾经的 DEEPSEEK_* 默认值是一层看不见、无法限额
# 的服务器成本，已删除；缺配置时 agent 明确报错，不会悄悄换一把 key。

# 生成随机性（0-2），越高越发散
AI_TEMPERATURE=0.8
# 单次 LLM 调用超时（秒）
AI_TIMEOUT=60
# 内容被 AI 审校拒绝后允许的最大重写次数；超限后接口报错
AI_REVIEW_MAX_RETRIES=2
